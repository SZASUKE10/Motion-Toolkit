<?xml version="1.0" encoding="UTF-8"?>

<ExtensionManifest
    Version="7.0"
    ExtensionBundleId="com.motiontoolkit.zylur"
    ExtensionBundleVersion="1.0.0"
    ExtensionBundleName="Motion Toolkit"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <ExtensionList>
        <Extension
            Id="com.motiontoolkit.zylur.panel"
            Version="1.0.0" />
    </ExtensionList>

    <ExecutionEnvironment>

        <HostList>
            <!-- After Effects 2026 -->
            <Host
                Name="AEFT"
                Version="[26.0,99.9]" />
        </HostList>

        <LocaleList>
            <Locale Code="All" />
        </LocaleList>

        <RequiredRuntimeList>
            <RequiredRuntime
                Name="CSXS"
                Version="12.0" />
        </RequiredRuntimeList>

    </ExecutionEnvironment>

    <DispatchInfoList>

        <Extension Id="com.motiontoolkit.zylur.panel">

            <DispatchInfo>

                <Resources>

                    <!-- CEP UI -->
                    <MainPath>./client/index.html</MainPath>

                    <!-- After Effects JSX -->
                    <ScriptPath>./host/index.jsx</ScriptPath>

                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>

                </Resources>

                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>

                <UI>

                    <Type>Panel</Type>

                    <Menu>Motion Toolkit</Menu>

                    <Geometry>

                        <Size>
                            <Width>320</Width>
                            <Height>600</Height>
                        </Size>

                        <MinSize>
                            <Width>250</Width>
                            <Height>300</Height>
                        </MinSize>

                    </Geometry>

                    <Icons />

                </UI>

            </DispatchInfo>

        </Extension>

    </DispatchInfoList>

</ExtensionManifest>